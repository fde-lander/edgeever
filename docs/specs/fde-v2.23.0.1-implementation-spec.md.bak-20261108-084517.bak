```bash
# Commit 1: merge（保留 merge 语义，方便单点回滚）
git add -A
git commit -m "merge: upstream v2.23.0 (37 migrations, 964 commits)"

# Commit 2: 隔离修复 + 冲突解决
git add apps/api/src/mcp-hiding.ts tests/mcp-hiding-poster-jobs.test.ts \
        tests/leak-matrix.test.ts apps/api/src/index.ts \
        apps/api/src/memo-service.ts apps/api/src/notebook-service.ts
